rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PUBLIC READ: Anyone can view your portfolio data
    match /{document=**} {
      allow read: if true;
    }
    
    // RESTRICTED WRITE: Only authenticated users (you/admin) can modify content
    // This protects your works, articles, and profile data from unauthorized changes
    match /site_content/{document=**} {
      allow write: if request.auth != null;
    }
    
    match /works/{document=**} {
      allow write: if request.auth != null;
    }
    
    match /articles/{document=**} {
      allow write: if request.auth != null;
    }
    
    match /settings/{document=**} {
      allow write: if request.auth != null;
    }
  }
}
